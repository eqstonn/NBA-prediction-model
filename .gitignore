# Ignore all data files
stats/

# Secrets (the Odds API key lives in the ODDS_API_KEY environment variable, never in the repo)
.env
*.env

# Ignore Python / pytest cache
__pycache__/
.pytest_cache/

# Ignore virtual environment
venv/
# Generated website (rebuild with: python code/build_site.py)
site/
# Daily run logs, lock and state (code/daily.py)
logs/
# Injury reports (code/injuries.py): ESPN's / CBS's terms don't allow republishing them, so they stay local
data/injuries_*.csv
